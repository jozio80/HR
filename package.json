{
  "name": "horong-resume-screener",
  "version": "0.3.0",
  "description": "호롱랩스 - 채용 워크스페이스 (소싱/서류스크리닝/면접/합격통보/온보딩, 100% 로컬 처리)",
  "main": "main.js",
  "author": "호롱랩스",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "mammoth": "^1.12.2",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "kr.horonglabs.resume-screener",
    "productName": "호롱 채용 워크스페이스",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/index.html",
      "renderer/app.js",
      "renderer/style.css",
      "!renderer/demo/**",
      "!test/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dir"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "asar": true
  }
}
